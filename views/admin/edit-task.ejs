<a href="/dashboard">&larr; Back</a>
<div class="admin-title">
  <h2>View / Edit Task</h2>

  <form action="/delete-task/<%= data._id %>?_method=DELETE" method="DELETE">
    <input type="submit" value="Delete" class="btn-delete btn" />
  </form>
</div>

<form action="/edit-task/<%= data._id %>?_method=PUT" method="POST">
  <label for="name"><b>Name</b></label>
  <input type="text" placeholder="" name="name" value="<%= data.name %>" />
  <label for="dogBreed"><b>Dog Breed</b></label>
  <input
    type="text"
    placeholder=""
    name="dogBreed"
    value="<%= data.dogBreed %>"
  />
  <label for="age"><b>Age</b></label>
  <input
    type="number"
    min="0"
    max="31"
    placeholder=""
    name="age"
    value="<%= data.age %>"
  />
  <br />
  <br />
  <label for="task"><b>What's the task?</b></label>
  <textarea name="task" cols="50" rows="10"><%= data.task %></textarea>

  <input type="submit" value="Update" class="btn" />
</form>
