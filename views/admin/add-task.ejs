<a href="/dashboard">&larr;</a>
<div class="admin-title">
  <h2>Add New Task</h2>
</div>
<form action="/add-task/" method="POST">
  <label for="name"><b>Name</b></label>
  <input type="text" placeholder="Dog's Name" name="name" />
  <label for="dogBreed"><b>Dog Breed</b></label>
  <input type="text" placeholder="Dog Breed" name="dogBreed" />
  <label for="age"><b>Age</b></label>
  <input type="number" min="0" max="31" placeholder="Age" name="age" />
  <br />
  <br />
  <label for="task"><b>What's the task?</b></label>
  <textarea name="task" cols="50" rows="10"></textarea>
  <input type="submit" value="Add" class="btn" />
</form>
